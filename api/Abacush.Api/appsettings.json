{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Abacush": "Data Source=.;Initial Catalog=Abacush;Persist Security Info=True;User ID=abacush;Password=abacush;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Command Timeout=0"
  },
  "Auth0": {
    "Domain": "your-tenant.us.auth0.com",
    "Audience": "https://your-api-identifier",
    "ClientId": "configure-in-user-secrets-or-environment",
    "ClientSecret": "configure-in-user-secrets-or-environment",
    "Scope": "openid profile email"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:4200",
      "http://localhost:4200"
    ]
  },
  "Application": {
    "ApplicationName": "Abacush",
    "TimeZone": "UTC"
  }
}
